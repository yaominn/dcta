# DCTA on the Tencent Cloud server. setup.sh copies this to /opt/dcta/.env and
# fills in the domain. Add OPENAI_API_KEY on the server yourself; never commit it.
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ASR_PROVIDER=openai

# A passkey only works on the domain it was made on, so these must name the
# HTTPS address people open.
WEBAUTHN_RP_ID=__DOMAIN__
WEBAUTHN_EXPECTED_ORIGIN=https://__DOMAIN__

# MOCK_SIGNING stays unset on a real server: it turns on signing without a passkey.
