# DCTA local configuration. Copy to ".env" and fill in ONLY when going live.
# NEVER commit the real .env — it is gitignored. (brief: swappable provider,
#   stubs used until real creds are present; config.has_credentials gates this.)

# --- Tencent Cloud credentials (left blank for M0 stubs) ---
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

# --- ASR (spike-confirmed: Singapore region, English supported) ---
TENCENT_ASR_REGION=ap-singapore
TENCENT_ASR_ENDPOINT=asr.ap-singapore.tencentcloudapi.com

# --- Hunyuan (function-calling; NOT schema-strict, so we validate+retry) ---
HUNYUAN_MODEL=hunyuan-functioncall
TENCENT_HUNYUAN_REGION=ap-guangzhou

# --- Provider selection & LLM behaviour ---
# auto (default) = Hunyuan when Tencent credentials exist, else the stub.
# Pin explicitly with: hunyuan | stub
# Pinning "hunyuan" makes a missing key fail loudly instead of silently
# serving stub output, which would look like the model working.
LLM_PROVIDER=auto
# Structured extraction, not prose: near-zero so the same transcript yields the
# same plan and the retry budget is spent on real ambiguity, not sampling noise.
LLM_TEMPERATURE=0
# A hung upstream call must not hold the HTTP request open indefinitely.
LLM_TIMEOUT_S=30
